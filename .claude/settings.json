{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm test*)",
      "Bash(npx live-server*)"
    ],
    "ask": [
      "Bash(git clean *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)"
    ],
    "deny": [
      "Bash(sudo*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod a+rwx*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/block-dangerous-commands.py",
            "statusMessage": "명령 안전 검사"
          }
        ]
      }
    ]
  }
}
